# Application
PORT=3000

# SQL Server
DB_HOST=sqlserver
DB_PORT=1433
DB_USERNAME=aivaroot
DB_PASSWORD=<define-a-strong-sqlserver-password>
DB_DATABASE=aivacol_fleet

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
VEHICLES_CACHE_TTL_SECONDS=60

# JWT
JWT_SECRET=<define-a-strong-jwt-secret>
JWT_EXPIRES_IN=1h

# Seed
SEED_USERNAME=aivacol
SEED_USER_PASSWORD=<define-a-strong-seed-user-password>
BCRYPT_SALT_ROUNDS=12

# AWS
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=<optional-when-using-aws-configure>
AWS_SECRET_ACCESS_KEY=<optional-when-using-aws-configure>
AWS_SQS_QUEUE_URL=<your-sqs-queue-url>
AWS_DYNAMODB_AUDIT_TABLE=audit-logs
